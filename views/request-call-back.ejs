<%- include('partials/head') %>
<%- include('partials/header') %>
<section class="hero hero-slim">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <span>Request Call Back</span></nav>
    <p class="eyebrow">Free personalized consultation</p>
    <h1>Request a Call Back</h1>
    <p class="hero-lede">Leave your name and number and one of our colleagues will get back in touch with you soon.</p>
  </div>
</section>
<section class="section">
  <div class="wrap contact-grid">
    <div class="side-card form-card">
      <h2>Request Form</h2>
      <%- include('partials/lead-form', { fid: 'rcb', fname: 'Request Call Back', withMessage: true }) %>
    </div>
    <div class="contact-info">
      <div class="info-block"><h2 class="h-sm">Rather call now?</h2><p><a class="big-phone" href="<%= site.phoneHref %>"><%= site.phone %></a><br>Toll-free <a href="<%= site.tollFreeHref %>"><%= site.tollFree %></a></p></div>
      <div class="info-block"><h2 class="h-sm">Hours</h2><dl class="hours"><% site.hours.forEach(function(h){ %><dt><%= h.days %></dt><dd><%= h.time %></dd><% }) %></dl></div>
      <%- include('partials/review', { review: reviews.ellen }) %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
