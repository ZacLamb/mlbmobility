</main>
<section class="trust-band" aria-label="Why Totally Mobile">
  <div class="wrap trust-grid">
    <div><strong>Since 1998</strong><span>Locally &amp; woman-owned</span></div>
    <div><strong>1-Year</strong><span>Labor warranty</span></div>
    <div><strong>Free</strong><span>Personalized consultation</span></div>
    <div><strong>We come to you</strong><span>In-home repairs, any brand</span></div>
  </div>
</section>
<footer class="site-footer">
  <div class="wave" aria-hidden="true"></div>
  <div class="wrap footer-grid">
    <div class="footer-col footer-about">
      <img src="<%= img('totally-mobile-logo-1920w.jpg') %>" alt="Totally Mobile LLC" width="170" height="57" loading="lazy" class="footer-logo">
      <p>Located in East Sandwich, MA. Totally Mobile LLC specializes in wheelchairs and mobility products. 1-year labor warranty. Free personalized consultation. Manufacturer warranties available. Call today for more information.</p>
      <a class="text-link" href="/hibu-video-splash">Watch our video →</a>
    </div>
    <div class="footer-col">
      <h2 class="footer-h">Visit Us</h2>
      <address>Totally Mobile LLC<br><%= site.address.street %><br><%= site.address.city %>, <%= site.address.state %> <%= site.address.zip %></address>
      <a class="text-link" href="<%= site.mapsUrl %>" target="_blank" rel="noopener">Get Directions →</a>
      <h2 class="footer-h mt">Business Hours</h2>
      <dl class="hours"><% site.hours.forEach(function(h){ %><dt><%= h.days %></dt><dd><%= h.time %></dd><% }) %></dl>
    </div>
    <div class="footer-col">
      <h2 class="footer-h">Contact Us</h2>
      <p class="footer-contact">
        <a href="<%= site.phoneHref %>"><%= site.phone %></a><br>
        Toll-free <a href="<%= site.tollFreeHref %>"><%= site.tollFree %></a><br>
        Fax <%= site.fax %>
      </p>
      <a class="btn btn-ghost-light btn-sm" href="/contact">Send a Message</a>
      <a class="fb" href="<%= site.facebook %>" target="_blank" rel="noopener" aria-label="Totally Mobile on Facebook"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.8c0-.9.3-1.5 1.6-1.5h1.7V4.4c-.3 0-1.3-.1-2.5-.1-2.4 0-4.1 1.5-4.1 4.2v2.3H7.5V14h2.7v8h3.3z"/></svg> Facebook</a>
    </div>
    <div class="footer-col">
      <h2 class="footer-h">Products &amp; Services</h2>
      <ul class="footer-links">
        <% servicePages.forEach(function(p){ %><li><a href="<%= p.path %>"><%= p.nav %></a></li><% }) %>
      </ul>
    </div>
  </div>
  <div class="wrap footer-towns">
    <h2 class="footer-h">Serving Cape Cod, the Islands &amp; the South Shore</h2>
    <ul class="town-chips">
      <% towns.forEach(function(t){ %><li><a href="/service-areas/<%= t.slug %>"><%= t.name %></a></li><% }) %>
    </ul>
  </div>
  <div class="wrap footer-legal">
    <p>© <%= new Date().getFullYear() %> Totally Mobile LLC · mlbmobility.com · *Pride® FDA Class II Medical Devices are designed to aid individuals with mobility impairments.</p>
    <p><a href="/privacy-policy">Privacy Policy</a> · <a href="/accessibility">Accessibility</a> · <a href="/sitemap.xml">Sitemap</a></p>
  </div>
</footer>
<div class="mobile-cta" aria-label="Quick contact">
  <a href="<%= site.phoneHref %>" class="mobile-cta-call">Call <%= site.phone %></a>
  <a href="/request-call-back" class="mobile-cta-cb">Call Back</a>
</div>
<script src="/js/site.js?v=3" defer></script>
</body>
</html>
