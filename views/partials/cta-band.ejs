<section class="cta-band">
  <div class="wrap cta-inner">
    <div>
      <h2><%= (typeof ctaTitle !== 'undefined' && ctaTitle) ? ctaTitle : 'Improve Your Mobility with Over 20 Years of Expertise' %></h2>
      <p><%= (typeof ctaSub !== 'undefined' && ctaSub) ? ctaSub : 'Call Totally Mobile LLC today!' %></p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-coral btn-lg" href="<%= site.phoneHref %>"><%= site.phone %></a>
      <a class="btn btn-ghost-light" href="/request-call-back">Request Call Back</a>
    </div>
  </div>
</section>
