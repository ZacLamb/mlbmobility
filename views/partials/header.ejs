<div class="promo-bar" role="note">
  <div class="wrap promo-inner">
    <span><%= site.promo %></span>
    <a href="/request-call-back">Ask about the sale →</a>
  </div>
</div>
<header class="site-header" id="top">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Totally Mobile LLC — home">
      <img src="<%= img('totally-mobile-logo-1920w.jpg') %>" alt="Totally Mobile LLC — Enjoy Your Life" width="238" height="85">
      <span class="brand-text">
        <span class="brand-sub">Mobility Products · Sales · Rentals · Service</span>
        <span class="brand-sub">East Sandwich · Cape Cod &amp; the Islands</span>
      </span>
    </a>
    <div class="header-actions">
      <a class="header-phone" href="<%= site.phoneHref %>"><span class="header-phone-label">Call us</span><span class="header-phone-num"><%= site.phone %></span></a>
      <a class="btn btn-coral btn-sm hide-sm" href="/request-call-back">Request Call Back</a>
      <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav"><span></span><span></span><span></span><span class="sr">Menu</span></button>
    </div>
  </div>
  <nav class="primary-nav" id="primary-nav" aria-label="Main">
    <ul class="wrap nav-list">
      <% site.nav.forEach(function(item){ var active = item.href === path || (item.children||[]).some(function(c){return c.href===path}); %>
        <li class="<%= item.children ? 'has-sub' : '' %> <%= active ? 'is-active' : '' %>">
          <% if (item.children) { %>
            <button class="nav-parent" aria-expanded="false"><%= item.label %><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></button>
            <ul class="sub">
              <% item.children.forEach(function(c){ %><li><a href="<%= c.href %>"<%= c.href===path ? ' aria-current=page' : '' %>><%= c.label %></a></li><% }) %>
            </ul>
          <% } else { %>
            <a href="<%= item.href %>"<%= item.href===path ? ' aria-current=page' : '' %>><%= item.label %></a>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </nav>
</header>
<main id="main">
