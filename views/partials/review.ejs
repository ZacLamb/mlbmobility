<% if (typeof review !== 'undefined' && review) { %>
<figure class="review-card">
  <svg class="quote-mark" width="48" height="40" viewBox="0 0 48 40" aria-hidden="true"><path fill="currentColor" d="M0 40V24C0 10 8 2 20 0l2 6c-7 2-11 7-11 14h9v20H0zm26 0V24C26 10 34 2 46 0l2 6c-7 2-11 7-11 14h9v20H26z"/></svg>
  <blockquote><p><%= review.text %></p></blockquote>
  <figcaption>— <%= review.name %><% if (review.topic) { %> <span>· <%= review.topic %></span><% } %></figcaption>
</figure>
<% } %>
