<%- include('partials/head', { schema: [{ '@context':'https://schema.org','@type':'FAQPage', mainEntity: faqs.map(function(f){ return { '@type':'Question', name: f.q, acceptedAnswer: { '@type':'Answer', text: f.a } }; }) }] }) %>
<%- include('partials/header') %>
<section class="hero hero-slim">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <span>FAQs</span></nav>
    <p class="eyebrow">Totally Mobile LLC</p>
    <h1>Frequently Asked Questions</h1>
    <p class="hero-lede">Have a wheelchair-related question? Totally Mobile LLC has the answer. Check out these FAQs and give us a call today for more information!</p>
  </div>
</section>
<section class="section">
  <div class="wrap narrow">
    <div class="faq-list">
      <% faqs.forEach(function(f, i){ %>
      <details class="faq"<%= i === 0 ? ' open' : '' %>>
        <summary><h2 class="faq-q"><%= f.q %></h2></summary>
        <p><%= f.a %><% if (f.link) { %> <a class="text-link" href="<%= f.link %>">Learn more →</a><% } %></p>
      </details>
      <% }) %>
    </div>
  </div>
</section>
<%- include('partials/cta-band') %>
<%- include('partials/footer') %>
